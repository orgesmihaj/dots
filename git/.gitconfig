; ─── gitsettings  ─────────────────────────────────────────────────╯

[alias]
  st = status
  co = checkout
  sw = switch
  rs = restore
  br = branch
  cm = commit -m
  ca = commit -a
  df = diff
  lg = log --oneline --graph --decorate
  amend = commit --amend
  undo = reset --soft HEAD~1
  who = shortlog -sn
  fix = commit --fixup
  squash = rebase -i --autosquash HEAD~5

[core] 
  editor = nvim
  autocrlf = input
  excludesfile = ~/.config/git/ignore
  filemode = true
  pager = delta
  whitespace = space-before-tab,-indent-with-non-tab,trailing-space

[init]
  defaultBranch = main

[color]
  ui = auto

[push]
  default = current
  autoSetupRemote = true

[pull]
  rebase = true

[fetch]
  prune = true

[rebase]
  autoStash = true
  autoSquash = true
  updateRefs = true

[rerere]
  enabled = true

[branch]
  sort = -committerdate

[commit]
  verbose = true

[merge]
  tool = nvimdiff
  conflictstyle = zdiff3

[diff]
  algorithm = histogram
  tool = nvimdiff
  colorMoved = default

[interactive]
  diffFilter = delta --color-only

[delta]
  navigate = true
  syntax-theme = Catppuccin Mocha
